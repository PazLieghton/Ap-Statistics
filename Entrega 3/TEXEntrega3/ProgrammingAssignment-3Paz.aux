\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces $\mathrm  {Var}(\hat  {y}_a)$ vs $x_a$. Blue: full covariance (correct). Orange dashed: diagonal only (incorrect). Green dotted: minimum at $\bar  {x} = 2.5$.}}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Confidence Bands}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Best-fit line with correct (darker) and diagonal-only (lighter) confidence bands. Dashed line: $\bar  {y} = 3.450$.}}{3}{}\protected@file@percent }
