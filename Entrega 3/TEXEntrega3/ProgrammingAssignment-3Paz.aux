\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Goodness of Fit}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Data with $\pm \sigma $ error bars and best-fit line $\hat  {y} = 1.45 + 0.799\,x$ over $x \in [0,5]$.}}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Uncertainty of Predicted Values}{2}{}\protected@file@percent }
