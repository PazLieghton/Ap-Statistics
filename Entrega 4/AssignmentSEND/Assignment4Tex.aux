\@writefile{toc}{\contentsline {section}{\numberline {1}Part A: Are the Digits Uniformly Distributed?}{1}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Observed digit counts $O_k$ (blue) and expected uniform counts $E_k = n/10$ (red) for old-format plates (left) and new-format plates (right). Error bars are: $\pm \sqrt  {O_k}$.}}{1}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:A2}{{1}{1}{}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Null $\chi ^2(9)$ density with observed statistics for old (blue) and new (orange) formats. Red shaded region is the rejection tail at $\alpha = 0.05$.}}{2}{}\protected@file@percent }
\newlabel{fig:A3}{{2}{2}{}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Part B: Do Old and New Format Plates Differ in Mean Digit Sum?}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Normality check for old-format digit sums: histogram with Gaussian fit (left) and Q-Q plot (right).}}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Normality check for new-format digit sums.}}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Null $t(\nu )$ density (two-tailed) with the observed Welch $t$-statistic. Red shaded regions are the rejection tails at $\alpha = 0.05$.}}{3}{}\protected@file@percent }
\newlabel{fig:B2}{{5}{3}{}{figure.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Part C: Do Old and New Format Plates Draw Letters from the Same Distribution?}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Relative letter frequencies for old-format (blue) and new-format (red) plates, with Poisson error bars $\pm \sqrt  {O_\ell }/n$.}}{4}{}\protected@file@percent }
\newlabel{fig:C1}{{6}{4}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Null $\chi ^2(\nu )$ density with the observed statistic from Part~C.}}{4}{}\protected@file@percent }
\newlabel{fig:C2}{{7}{4}{}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Standardised residuals per letter. Dashed red lines mark the unadjusted $\pm 2\sigma $ per-bin band; dotted dark red lines mark the Bonferroni-corrected $\pm 3.29\sigma $ threshold (95\% FWER, $K=26$). Red bars are the five largest contributors to $\chi ^2$. Note that this is something new I tried to do, references are on the bottom.}}{5}{}\protected@file@percent }
\newlabel{fig:C3}{{8}{5}{}{figure.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Part D: Are Certain Letter Pairs Suppressed?}{5}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Null $\chi ^2(K^2-1)$ density rescaled to $\pm 5\sigma $ around the null mean due to a suggestion by the professor, with the observed statistic from Part~D marked. The null is centred at $\nu \approx 675$; the observed statistic at $\approx 1001$ falls far into the rejection region ($p = 3.84 \times 10^{-15}$).}}{5}{}\protected@file@percent }
\newlabel{fig:D1}{{9}{5}{}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Standardised residual matrix $(P_{jk}-E_{jk})/\sqrt  {E_{jk}}$. Blue = under-represented; red = over-represented. Black outlines mark the five most extreme pairs in each direction.}}{6}{}\protected@file@percent }
\newlabel{fig:D2}{{10}{6}{}{figure.10}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Part E: Is Our Sample Biased Toward Older or Newer Plates?}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Estimated registration years for old-format (blue) and new-format (red) plates. The dashed black line is $H_0: \mu _0 = 2010.5$ (midpoint 1995-2026); the purple shaded band is the 95\% CI on the sample mean. If the dashed line falls outside the band, $H_0$ is rejected. Annotations boxes were a nightmare.}}{7}{}\protected@file@percent }
\newlabel{fig:E1}{{11}{7}{}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Null $t(\nu )$ density (two-tailed) with the observed $t$-statistic for Part~E.}}{7}{}\protected@file@percent }
